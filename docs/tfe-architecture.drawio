  <diagram name="Components" id="components">
    <mxGraphModel dx="2814" dy="1718" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="200" value="Component Details" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="60" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="201" value="TFE Pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=14;fontStyle=1;align=left;arcSize=4;" parent="1" vertex="1">
          <mxGeometry x="80" y="140" width="400" height="240" as="geometry" />
        </mxCell>
        <mxCell id="202" value="Image: hashicorp/terraform-enterprise:latest&#xa;Replicas: 1&#xa;&#xa;Resources:&#xa;  Requests: 2 CPU, 4Gi RAM&#xa;  Limits: 4 CPU, 8Gi RAM&#xa;&#xa;Environment:&#xa;  TFE_HOSTNAME=tfe.localtest.me&#xa;  TFE_OPERATIONAL_MODE=external&#xa;  TFE_DATABASE_HOST=postgres.terraform-enterprise.svc&#xa;&#xa;Volumes:&#xa;  • TLS Certs: /etc/ssl/private/tfe/&#xa;  • License: /etc/terraform-enterprise/&#xa;  • Data: /var/lib/terraform-enterprise/ (20Gi PVC)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="90" y="160" width="380" height="160" as="geometry" />
        </mxCell>
        <mxCell id="203" value="PostgreSQL Pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=14;fontStyle=1;align=left;arcSize=6;" parent="1" vertex="1">
          <mxGeometry x="80" y="390" width="400" height="220" as="geometry" />
        </mxCell>
        <mxCell id="204" value="Image: postgres:14-alpine&#xa;Replicas: 1&#xa;&#xa;Resources:&#xa;  Requests: 1 CPU, 2Gi RAM&#xa;  Limits: 2 CPU, 4Gi RAM&#xa;&#xa;Environment:&#xa;  POSTGRES_USER=terraform&#xa;  POSTGRES_DB=tfe&#xa;  POSTGRES_PASSWORD=(from secret)&#xa;  PGDATA=/var/lib/postgresql/data/pgdata&#xa;&#xa;Volume: /var/lib/postgresql/data/ (10Gi PVC)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="90" y="410" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="205" value="Secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontSize=14;fontStyle=1;align=left;arcSize=5;" parent="1" vertex="1">
          <mxGeometry x="560" y="140" width="400" height="230" as="geometry" />
        </mxCell>
        <mxCell id="206" value="tfe-tls (kubernetes.io/tls):&#xa;  • tls.crt: Self-signed certificate&#xa;  • tls.key: Private key&#xa;  • Valid: 365 days&#xa;  • Hostname: tfe.localtest.me&#xa;&#xa;tfe-license (Opaque):&#xa;  • license: TFE license file content&#xa;  • Source: $TFE_LICENSE_PATH (env var)&#xa;&#xa;postgres-credentials (Opaque):&#xa;  • password: PostgreSQL password&#xa;  • Default: terraform_password_change_me&#xa;  • Used by: TFE and PostgreSQL pods" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="570" y="170" width="380" height="160" as="geometry" />
        </mxCell>
        <mxCell id="207" value="Services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=14;fontStyle=1;align=left;arcSize=4;" parent="1" vertex="1">
          <mxGeometry x="560" y="390" width="400" height="210" as="geometry" />
        </mxCell>
        <mxCell id="208" value="TFE Service (ClusterIP):&#xa;  • Port: 443 (HTTPS)&#xa;  • DNS: tfe.terraform-enterprise.svc.cluster.local&#xa;  • Selector: app.kubernetes.io/name=terraform-enterprise&#xa;&#xa;PostgreSQL Service (ClusterIP):&#xa;  • Port: 5432&#xa;  • DNS: postgres.terraform-enterprise.svc.cluster.local&#xa;  • Selector: app=postgres" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="560" y="414" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="209" value="Storage (PVCs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontSize=14;fontStyle=1;align=left;arcSize=5;" parent="1" vertex="1">
          <mxGeometry x="560" y="620" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="210" value="tfe-data-pvc:&#xa;  • Size: 20Gi&#xa;  • StorageClass: standard (local-path)&#xa;  • AccessMode: ReadWriteOnce (RWO)&#xa;  • Purpose: TFE application data, workspaces, state files&#xa;&#xa;postgres-pvc:&#xa;  • Size: 10Gi&#xa;  • StorageClass: standard (local-path)&#xa;  • AccessMode: ReadWriteOnce (RWO)&#xa;  • Purpose: PostgreSQL database files" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="560" y="640" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="211" value="Access Configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontSize=14;fontStyle=1;align=left;arcSize=7;" parent="1" vertex="1">
          <mxGeometry x="80" y="620" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="212" value="Port Forwarding:&#xa;  • Command: kubectl port-forward svc/tfe -n terraform-enterprise 8443:443&#xa;  • Maps: localhost:8443 → TFE:443&#xa;  • Script: scripts/port-forward.sh&#xa;  • Must remain running for access&#xa;&#xa;DNS Resolution:&#xa;  • Domain: tfe.localtest.me&#xa;  • Resolves to: 127.0.0.1 via public DNS&#xa;  • Purpose: TLS certificate validation&#xa;&#xa;URL: https://tfe.localtest.me:8443" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="90" y="640" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="213" value="Deployment Automation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=13;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="80" y="30" width="720" height="90" as="geometry" />
        </mxCell>
        <mxCell id="214" value="scripts/setup-all.sh orchestrates: prerequisites → namespace → secrets → PostgreSQL → PVCs → Helm release&#xa;scripts/port-forward.sh maintains operator access&#xa;helm/values.yaml pins hashicorp/terraform-enterprise settings (hostname, TLS, license, PVC)&#xa;manifests/secrets/*.sh keep secrets reproducible from local assets" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="90" y="70" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="215" value="Kind Nodes&#xa;• control-plane: runs critical pods (TFE, PostgreSQL)&#xa;• worker: optional capacity for runners / future scaling&#xa;• Container runtime: Docker Desktop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f1de;strokeColor=#c9b458;verticalAlign=top;fontSize=12;fontStyle=1;align=left;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="80" y="840" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="216" value="Local Path Provisioner&#xa;• Backs PVCs with hostPath volumes on Docker Desktop&#xa;• Ensures tfe-data-pvc / postgres-pvc survive pod restarts&#xa;• Clean up with kubectl delete pvc --all when done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#4a90e2;verticalAlign=top;fontSize=12;fontStyle=1;align=left;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="560" y="840" width="400" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
